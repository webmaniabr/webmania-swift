{
  "openapi": "3.1.0",
  "info": {
    "title": "Webmania Monitor Fiscal — read operations draft",
    "version": "0.2.0-draft.20261025",
    "description": "Six Monitor read operations. This module is not full Monitor coverage or an integration certification. Documents, reports, events, imports, notifications and writes live in separate modules."
  },
  "servers": [
    {
      "url": "https://api.webmania.com.br"
    }
  ],
  "paths": {
    "/2/monitor/empresas": {
      "get": {
        "operationId": "monitorListCompanies",
        "summary": "List monitored companies",
        "tags": [
          "Monitor Fiscal"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 10,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "pesquisa",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 3
            }
          }
        ],
        "description": "",
        "security": [
          {
            "MonitorBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Monitor response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorCompanyPage"
                }
              }
            }
          },
          "default": {
            "description": "Authentication, capability, subscription, validation or service error. Preserve status; redact tokens and personal data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-monitor-fiscal/#listar-empresas",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0,
          "notes": "Reads may update normal authentication, audit or server cache state."
        }
      }
    },
    "/2/monitor/empresas/{company}": {
      "get": {
        "operationId": "monitorGetCompany",
        "summary": "Get a monitored company",
        "tags": [
          "Monitor Fiscal"
        ],
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID of a company owned by the authenticated Monitor account."
          }
        ],
        "description": "",
        "security": [
          {
            "MonitorBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Monitor response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorCompany"
                }
              }
            }
          },
          "default": {
            "description": "Authentication, capability, subscription, validation or service error. Preserve status; redact tokens and personal data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-monitor-fiscal/#buscar-empresa",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0,
          "notes": "Reads may update normal authentication, audit or server cache state."
        }
      }
    },
    "/2/monitor/empresas/{company}/municipios-nfse": {
      "get": {
        "operationId": "monitorListCompanyMunicipalities",
        "summary": "List configured nonnative NFS-e municipality monitoring",
        "tags": [
          "Monitor Fiscal"
        ],
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID of a company owned by the authenticated Monitor account."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 10,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "municipio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 3
            }
          },
          {
            "name": "uf",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          {
            "name": "codigo_ibge",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{7}$"
            }
          }
        ],
        "description": "Lists configured registrations, not all municipalities monitored natively. Optional filters must be nonempty when present.",
        "security": [
          {
            "MonitorBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Monitor response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorMunicipalityPage"
                }
              }
            }
          },
          "default": {
            "description": "Authentication, capability, subscription, validation or service error. Preserve status; redact tokens and personal data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-monitor-fiscal/#listar-municipios-monitorados",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0,
          "notes": "Reads may update normal authentication, audit or server cache state."
        }
      }
    },
    "/2/monitor/empresas/{company}/municipios-nfse/{download}": {
      "get": {
        "operationId": "monitorGetCompanyMunicipality",
        "summary": "Get a municipality-monitoring registration",
        "tags": [
          "Monitor Fiscal"
        ],
        "parameters": [
          {
            "name": "company",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID of a company owned by the authenticated Monitor account."
          },
          {
            "name": "download",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID of the municipality-monitoring registration belonging to this company."
          }
        ],
        "description": "",
        "security": [
          {
            "MonitorBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Monitor response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorMunicipalityRegistration"
                }
              }
            }
          },
          "default": {
            "description": "Authentication, capability, subscription, validation or service error. Preserve status; redact tokens and personal data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-monitor-fiscal/#listar-municipios-monitorados",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0,
          "notes": "Reads may update normal authentication, audit or server cache state."
        }
      }
    },
    "/2/monitor/municipios-nfse": {
      "get": {
        "operationId": "monitorListAvailableMunicipalities",
        "summary": "List or look up NFS-e municipalities",
        "tags": [
          "Monitor Fiscal"
        ],
        "parameters": [
          {
            "name": "codigo_ibge",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{7}$"
            }
          }
        ],
        "description": "Omit codigo_ibge for the {data:[...]} list envelope. Supplying codigo_ibge returns an unwrapped municipality object; an unknown code returns the seven false flags. Do not require the list envelope for a filtered lookup.",
        "security": [
          {
            "MonitorBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Monitor response.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/MonitorAvailableMunicipalities"
                    },
                    {
                      "$ref": "#/components/schemas/MonitorAvailableMunicipality"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Authentication, capability, subscription, validation or service error. Preserve status; redact tokens and personal data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-monitor-fiscal/#municipios-disponiveis",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0,
          "notes": "Reads may update normal authentication, audit or server cache state."
        }
      }
    },
    "/2/monitor/estatisticas/downloads": {
      "get": {
        "operationId": "monitorGetDownloadStatistics",
        "summary": "Get monthly document-download statistics",
        "tags": [
          "Monitor Fiscal"
        ],
        "parameters": [
          {
            "name": "ano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 2025
            },
            "description": "Required together with mes; four digits; maximum is the current year."
          },
          {
            "name": "mes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 12
            },
            "description": "Required together with ano. Numeric month values are accepted; use a calendar month integer. The year/month combination cannot be in the future."
          }
        ],
        "description": "ano and mes must either both be absent or both supplied. Server clock determines the current month and upper year bound.",
        "security": [
          {
            "MonitorBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Monitor response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorDownloadStatistics"
                }
              }
            }
          },
          "default": {
            "description": "Authentication, capability, subscription, validation or service error. Preserve status; redact tokens and personal data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-monitor-fiscal/#consultar-downloads",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0,
          "notes": "Reads may update normal authentication, audit or server cache state."
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MonitorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-side Monitor access token with fdmanagement capability and active subscription. Never substitute issuer, X-Token or API1 company credentials; no fallback."
      }
    },
    "schemas": {
      "MonitorError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "msg": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "description": "Error fields vary by authentication, validation and service layer. Treat non-2xx and an error property as failure; retain HTTP status and redact secrets."
      },
      "MonitorPagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "minimum": 1
          },
          "last_page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true,
        "required": [
          "current_page",
          "last_page",
          "per_page",
          "total"
        ]
      },
      "MonitorAddress": {
        "type": "object",
        "properties": {
          "cep": {
            "type": "string"
          },
          "municipio": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "codigo_municipio": {
            "type": [
              "string",
              "integer"
            ],
            "description": "IBGE municipality code. The public company guide documents an integer and company responses return integers; preserve string representations from compatible response variants without coercion."
          }
        },
        "additionalProperties": true,
        "description": "Absent/empty address fields may be omitted. Postal codes remain strings. codigo_municipio preserves the actual integer or string wire representation."
      },
      "MonitorCompany": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "integer"
          },
          "cpf": {
            "type": "string"
          },
          "cnpj": {
            "type": "string"
          },
          "nome_completo": {
            "type": "string"
          },
          "razao_social": {
            "type": "string"
          },
          "im": {
            "type": "string"
          },
          "endereco": {
            "$ref": "#/components/schemas/MonitorAddress"
          },
          "modelos_download": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "categorias_download": {
            "type": "integer"
          },
          "ambiente_download": {
            "type": "integer"
          },
          "certificado_vencimento": {
            "type": "string",
            "description": "Local calendar timestamp YYYY-MM-DD HH:mm:ss; no timezone offset is guaranteed."
          },
          "url_notificacao": {
            "type": "string",
            "format": "uri"
          },
          "dfe_retroativas": {
            "type": "boolean"
          },
          "dfe_retroativas_total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true,
        "required": [
          "uuid"
        ],
        "description": "Known company response fields. The current resource omits null, false, zero and empty values, so consumers must not require optional flags to be present. CPF/name or CNPJ/legal name depend on the person type. The modelos_download token cte provisions both CT-e and CT-e OS; search/response subtype remains cte_os. Unknown fields must survive."
      },
      "MonitorMunicipalityRegistration": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "tipo_download": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "municipio": {
            "type": "string"
          },
          "uf": {
            "type": "string"
          },
          "codigo_ibge": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "im": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "uuid",
          "tipo_download",
          "municipio",
          "uf",
          "codigo_ibge"
        ],
        "description": "The response never contains the municipality password. Empty optional fields are omitted. tipo_download=1 received documents; 2 issued documents."
      },
      "MonitorAvailableMunicipality": {
        "type": "object",
        "properties": {
          "municipio": {
            "type": "string"
          },
          "uf": {
            "type": "string"
          },
          "codigo_ibge": {
            "type": "string",
            "pattern": "^[0-9]{7}$"
          },
          "nativo": {
            "type": "boolean"
          },
          "im": {
            "type": "boolean"
          },
          "certificado": {
            "type": "boolean"
          },
          "login_senha": {
            "type": "boolean"
          },
          "cadastro_prefeitura": {
            "type": "boolean"
          },
          "domicilio_fiscal_municipio": {
            "type": "boolean"
          },
          "multiplos_servicos": {
            "type": "boolean"
          },
          "download_emitidas": {
            "type": "boolean"
          },
          "download_recebidas": {
            "type": "boolean"
          },
          "guia_cadastro_prefeitura": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true,
        "required": [
          "nativo",
          "im",
          "certificado",
          "login_senha",
          "cadastro_prefeitura",
          "domicilio_fiscal_municipio",
          "multiplos_servicos"
        ],
        "description": "Without a matching codigo_ibge the response contains only the seven required false capability flags. download_emitidas/download_recebidas are documented optional fields; current responses omit them. Do not infer those capabilities from missing values."
      },
      "MonitorDownloadStatistics": {
        "type": "object",
        "properties": {
          "total_downloads": {
            "type": "integer",
            "minimum": 0
          },
          "empresas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "empresa_uuid": {
                  "type": "string",
                  "format": "uuid"
                },
                "total_downloads": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true,
              "required": [
                "empresa_uuid",
                "total_downloads"
              ]
            },
            "maxItems": 10
          }
        },
        "additionalProperties": true,
        "required": [
          "total_downloads",
          "empresas"
        ],
        "description": "Monthly documents received by the authenticated account, with the top ten companies. Default is the current calendar month; future months are rejected."
      },
      "MonitorCompanyPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonitorCompany"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/MonitorPagination"
          }
        },
        "additionalProperties": true,
        "required": [
          "data",
          "meta"
        ]
      },
      "MonitorMunicipalityPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonitorMunicipalityRegistration"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/MonitorPagination"
          }
        },
        "additionalProperties": true,
        "required": [
          "data",
          "meta"
        ]
      },
      "MonitorAvailableMunicipalities": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonitorAvailableMunicipality"
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "data"
        ]
      }
    }
  },
  "x-compatibility-alias": {
    "prefix": "/2/gestao-documentos-fiscais",
    "canonical_prefix": "/2/monitor",
    "notes": "Legacy routes are aliases; SDKs should use the canonical public prefix."
  }
}
