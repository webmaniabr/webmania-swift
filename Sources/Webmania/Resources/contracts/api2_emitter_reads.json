        "additionalProperties": true,
        "required": [
          "operacional",
          "mensagem"
        ],
        "description": "The current service always probes the production SEFAZ environment. Operational=true returns HTTP 200; operational=false returns HTTP 503, preserving the body as failure context. A configured A1 certificate and eligible NFCom subscription are required."
      },
