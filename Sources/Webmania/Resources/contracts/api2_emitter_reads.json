{
  "openapi": "3.1.0",
  "info": {
    "title": "Webmania Emissor Fiscal API2 — read capabilities and NFSe event draft",
    "version": "0.2.0-draft.20261025",
    "description": "Six concrete operations. This module covers reads and NFSe events only; model emissions, other events, files and company management live in other modules."
  },
  "servers": [
    {
      "url": "https://api.webmania.com.br"
    }
  ],
  "paths": {
    "/2/nfse/status": {
      "get": {
        "operationId": "emitterGetNfseProviderStatus",
        "summary": "Read the company NFSe provider capabilities",
        "tags": [
          "Emissor Fiscal API2"
        ],
        "security": [
          {
            "IssuerBearer": []
          }
        ],
        "parameters": [
          {
            "name": "todos_servicos",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Option to include all city service codes rather than filtering by company CNAE."
          }
        ],
        "responses": {
          "200": {
            "description": "Business response; distinguish fiscal/service status from HTTP success. A present error property is a functional failure even at HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/NfseProviderStatus"
                    },
                    {
                      "$ref": "#/components/schemas/EmitterFunctionalError"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Authentication, subscription, fiscal or provider error, possibly with HTTP 200. No automatic retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmitterError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-nfse/#status",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0
        }
      }
    },
    "/2/nfcom/status": {
      "get": {
        "operationId": "emitterGetNfcomServiceStatus",
        "summary": "Read production SEFAZ NFCom service availability",
        "tags": [
          "Emissor Fiscal API2"
        ],
        "security": [
          {
            "IssuerBearer": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Business response; distinguish fiscal/service status from HTTP success. A present error property is a functional failure even at HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/NfcomServiceStatus"
                    },
                    {
                      "$ref": "#/components/schemas/EmitterFunctionalError"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Authentication, subscription, fiscal or provider error, possibly with HTTP 200. No automatic retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmitterError"
                }
              }
            }
          },
          "503": {
            "description": "SEFAZ service unavailable; return as an HTTP failure while retaining/redacting safe business context.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NfcomServiceStatus"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-nfcom/#status",
        "x-operation-effects": {
          "business_mutation": false,
          "automatic_retries": 0
        }
      }
    },
    "/2/nfse/consulta/{identifier}": {
      "get": {
        "operationId": "emitterGetNfse",
        "summary": "Consult a company-owned NFSe or RPS batch",
        "tags": [
          "Emissor Fiscal API2"
        ],
        "security": [
          {
            "IssuerBearer": []
          }
        ],
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "UUID is documented; the API also accepts the original order ID. An access key is not automatically treated as a UUID/order ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Business response; distinguish fiscal/service status from HTTP success. A present error property is a functional failure even at HTTP 200.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/NfseFiscalResponse"
                    },
                    {
                      "$ref": "#/components/schemas/EmitterFunctionalError"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Authentication, subscription, fiscal or provider error, possibly with HTTP 200. No automatic retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmitterError"
                }
              }
            }
          }
        },
        "x-public-documentation": "https://webmania.com.br/docs/rest-api-nfse/#consultar-nfse",
        "x-operation-effects": {
          "business_mutation": "may_process_pending_issue_or_cancellation",
          "automatic_retries": 0
        },
        "description": "Only documents already in a stable approved state can be read passively. Processing/received documents can trigger contingency/receipt processing; processando_cancelamento can trigger a cancellation request. GET alone does not guarantee no fiscal side effects. Never read an arbitrary pending document as if it were a passive check."
      }
    },
    "/2/nfcom/consulta/{identifier}": {
      "get": {
        "operationId": "emitterGetNfcom",
