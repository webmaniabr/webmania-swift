        "additionalProperties": true,
        "required": [
          "status",
          "ambientes",
          "autenticacao",
          "emissao",
          "funcoes",
          "pdf_nfse",
          "pdf_sincrono"
        ],
        "description": "Company/provider capabilities. Successful status=true does not authorize issuing without checking the returned environment/authentication/model/function support. Error status=false responses are functional errors, not a successful capability lookup."
      },
      "NfcomServiceStatus": {
        "type": "object",
        "properties": {
          "operacional": {
            "type": "boolean"
          },
          "mensagem": {
            "type": "string"
          }
