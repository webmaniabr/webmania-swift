          "status": {
            "type": "boolean"
          },
          "configured": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "description": "The API can return a functional error in HTTP 200. A present error property is always failure. Redact all service credentials and preserve HTTP status."
      },
